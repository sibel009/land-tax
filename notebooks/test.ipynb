   "source": [
    "using Plots\n",
    "\n",
    "g(x; c, x1, x2, s) = (\n",
    "    c/2 + (1/2)*(c/(x2 - x1))*((x-x1)^2 + (c/(x2 - x1))^2 * s^2)^(1/2) \n",
    "    - (1/2)*c/(x2 - x1)*((x-x2)^2 + (c/(x2 - x1))^2 * s^2)^(1/2)\n",
    ")\n",
    "\n",
    "path = g.(1:500-100+2; c=0.02, x1=50, x2=150, s=30000)\n",
    "\n",
    "plot(path)"
   ]
