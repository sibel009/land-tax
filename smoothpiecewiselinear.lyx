\begin_layout Title
Smooth a piecewise linear function
\end_layout

\begin_layout Author
Jiacheng Li
\end_layout

\begin_layout Section
The original function 
\end_layout

\begin_layout Standard
The original function 
\begin_inset Formula $f\left(x\right)$
\end_inset

 is piecewise linear and takes the form:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
f\left(x\right)=\begin{cases}
0 & x\leq x_{1}\\
\left(\frac{c}{x_{2}-x_{1}}\right)x-\frac{c}{x_{2}-x_{1}}x_{1} & x_{1}<x\leq x_{2}\\
c & x>x_{2}
\end{cases}
\]

\end_inset


\end_layout

\begin_layout Section
Smoothing scheme
\end_layout

\begin_layout Standard
The smoothed function 
\begin_inset Formula $g\left(.\right)$
\end_inset

 with smoothing parameter 
\begin_inset Formula $s$
\end_inset

 is 
\begin_inset Formula 
\[
\begin{aligned}g(x;s)= & \frac{c}{2}+\frac{1}{2}\left(\frac{c}{x_{2}-x_{1}}\right)\left(\left(x-x_{1}\right)^{2}+\left(\frac{c}{x_{2}-x_{1}}\right)^{2}s^{2}\right)^{\frac{1}{2}}\\
 & -\frac{1}{2}\left(\frac{c}{x_{2}-x_{1}}\right)\left(\left(x-x_{2}\right)^{2}+\left(\frac{c}{x_{2}-x_{1}}\right)^{2}s^{2}\right)^{\frac{1}{2}}
\end{aligned}
\]

\end_inset


\end_layout

